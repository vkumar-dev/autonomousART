{
  "name": "autonomousart",
  "version": "1.0.0",
  "description": "Autonomous generative art creation system powered by Hugging Face GGUF models",
  "main": "scripts/art-generator.js",
  "scripts": {
    "resolve-model": "python3 scripts/model_resolver.py",
    "generate-concept": "node scripts/concept-generator.js",
    "generate-concept-legacy": "node scripts/ollama-concept-generator.js",
    "generate-art": "node scripts/art-generator.js",
    "build-gallery": "node scripts/build-gallery.js",
    "generate-all": "npm run resolve-model && npm run generate-concept && npm run generate-art && npm run build-gallery",
    "prompts:list": "node scripts/prompt-manager.js --list",
    "prompts:tasks": "node scripts/prompt-manager.js --tasks",
    "prompts:show": "node scripts/prompt-manager.js --show",
    "prompts:search": "node scripts/prompt-manager.js --search",
    "workflow:concept": "node scripts/workflow-executor.js --concept",
    "workflow:full": "node scripts/workflow-executor.js --full",
    "workflow:execute": "node scripts/workflow-executor.js --execute",
    "workflow:history": "node scripts/workflow-executor.js --history"
  },
  "keywords": [
    "generative-art",
    "creative-coding",
    "autonomous",
    "huggingface",
    "gguf",
    "llama-cpp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
